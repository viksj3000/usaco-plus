{
   "manifest_version": 3,
   "name": "USACO Plus",
   "description": "Dark mode, test data download, solution viewer, and problem tracker for USACO",
   "version": "1.0.0",
   "icons": {
      "16": "icons/16x16.png",
      "32": "icons/32x32.png",
      "48": "icons/48x48.png",
      "128": "icons/128x128.png"
   },
   "background": {
      "service_worker": "background.js"
   },
   "action": {
      "default_popup": "popup.html",
      "default_title": "USACO Plus"
   },
   "content_scripts": [ {
      "js": [ "browser-polyfill.min.js", "contentScript.js" ],
      "css": [ "common.css" ],
      "matches": [ "*://usaco.org/*" ],
      "run_at": "document_start"
   } ],
   "permissions": [
      "storage"
   ],
   "host_permissions": [
      "*://usaco.org/*",
      "https://fonts.googleapis.com/*"
   ],
   "web_accessible_resources": [
      {
        "resources": [ "index.js" ],
        "matches": [ "*://usaco.org/*" ]
      }
   ]
}
